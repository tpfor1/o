# Copy this file to `.env` and fill in your own values.
#   macOS/Linux:  cp .env.example .env
#   Windows:      Copy-Item .env.example .env
#This template contains fake values only.

# --- LLM backend ---
# Which backend to use: anthropic | openai | ollama
JARVIS_LLM_BACKEND=anthropic

# API keys (only fill in the one(s) you use)
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# Model names (optional; sensible defaults will be used if blank)
JARVIS_ANTHROPIC_MODEL=
JARVIS_OPENAI_MODEL=

# Local models via Ollama
OLLAMA_HOST=http://localhost:11434
JARVIS_OLLAMA_MODEL=llama3.1

# --- Audio ---
# Leave blank to use the system default devices
JARVIS_INPUT_DEVICE=
JARVIS_OUTPUT_DEVICE=
JARVIS_WAKE_WORD=jarvis

# --- General ---
# DEBUG | INFO | WARNING | ERROR
JARVIS_LOG_LEVEL=INFO

# Override where config/data/logs are stored (blank = OS default via platformdirs)
JARVIS_HOME=
