# Normalize line endings: LF in the repo and on checkout, on every OS
* text=auto eol=lf

# Windows-native scripts need CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must stay LF
*.sh text eol=lf

# Binary files: don't convert or diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
*.onnx binary
*.pt binary
*.ppn binary

# Keep the lockfile out of diffs/language stats
uv.lock linguist-generated=true -diff
